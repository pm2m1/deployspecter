# EXPERIMENTAL isolated runner image. The base is pinned by digest; Python dependencies are installed only from a
# requirements file with hashes (--require-hashes, --no-deps); the payload is copied in, never mounted.
FROM python@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-deps --require-hashes -r /tmp/requirements.txt && rm /tmp/requirements.txt
COPY app/ /app/
RUN chmod -R a-w /app
USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["python", "-I", "-B"]
