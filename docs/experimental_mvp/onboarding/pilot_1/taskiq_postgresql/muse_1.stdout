{
 "dependencies": [
  "taskiq>=0.11.7",
  "psycopg[binary,pool]>=3.2.9"
 ],
 "install_metadata": false,
 "package": "taskiq-postgresql",
 "seam": "pool",
 "steps": {
  "enqueue": "taskiq_postgresql.PostgresqlBroker.task plus Task.kiq \u2014 documented pattern is decorator then kiq e.g. calculate_sum.kiq; no documented binding for harness trusted task taking int n calling recorder.handled",
  "install": "unknown \u2014 no explicit schema-install API documented; docs only state library automatically creates tables and show taskiq_postgresql.PostgresqlBroker.startup",
  "work": "unknown \u2014 no worker run-until-done API documented; docs only show taskiq_postgresql.PostgresqlBroker.startup/shutdown and Task.wait_result"
 },
 "task": {
  "args": [
   "n"
  ],
  "name": "unknown"
 },
 "unknowns": [
  "how to route all database I/O through harness AsyncSteppedConnection: docs only show dsn string construction with driver asyncpg/psycopg/psqlpy plus connect_kwargs, no injection of existing connection or pool",
  "DSN or connection parameters for harness database not documented",
  "explicit install/migrate API: docs only say tables are automatically created, plus taskiq_postgresql.PostgresqlBroker.startup and shutdown",
  "how to register harness trusted task taking int n that calls recorder.handled as a taskiq task: docs only show example tasks defined with @broker.task",
  "worker execution API to run until expect jobs done then stop: no worker class or listen loop documented",
  "whether taskiq_postgresql.PostgresqlResultBackend is required for work step and its startup requirements",
  "install_metadata meaning and content: no install-metadata API documented",
  "workload keys and counts: no documented mapping of recorder keys to taskiq messages",
  "whether scheduler source taskiq_postgresql.PostgresqlSchedulerSource is relevant: docs show it but harness has no schedule step"
 ],
 "workload": []
}
