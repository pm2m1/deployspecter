   "sql": "INSERT INTO \"saq_alt_jobs\" ( key, job, queue, status, priority, group_key, scheduled ) VALUES ( %(key)s, %(job)s, %(queue)s, %(status)s, %(priority)s, %(group_key)s, %(scheduled)s ) ON CONFLICT (key) DO UPDATE SET job = %(job)s, queue = %(queue)s, status = %(status)s, priority = %(priority)s, group_key = %(group_key)s, scheduled = %(scheduled)s, expire_at = null WHERE \"saq_alt_jobs\".status IN ('aborted', 'complete', 'failed') AND %(scheduled)s > \"saq_alt_jobs\".scheduled RETURNING 1",
